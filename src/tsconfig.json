{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "lib": ["ES2018", "DOM"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.js"]
}
