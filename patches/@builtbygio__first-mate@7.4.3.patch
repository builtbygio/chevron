diff --git a/lib/grammar-registry.js b/lib/grammar-registry.js
index ebcf62874b0e6b2f5e83f279f42a2997bedd6137..d6ef53668511f208a0d04b2e9c61cb26f9bb2847 100644
--- a/lib/grammar-registry.js
+++ b/lib/grammar-registry.js
@@ -3,7 +3,27 @@
 
   _ = require('underscore-plus');
 
-  CSON = require('season');
+  // Grammars are JSON. season's readFileSync is a bare JSON.parse for any
+  // extension but .cson, and nothing in Chevron is CSON, so this drops the
+  // season -> cson-parser -> coffee-script chain from the installer.
+  CSON = {
+    readFileSync: function(grammarPath) {
+      var contents = require('fs').readFileSync(grammarPath, 'utf8');
+      return contents.trim().length === 0 ? null : JSON.parse(contents);
+    },
+    readFile: function(grammarPath, callback) {
+      require('fs').readFile(grammarPath, 'utf8', function(error, contents) {
+        if (error != null) return callback(error);
+        var parsed;
+        try {
+          parsed = contents.trim().length === 0 ? null : JSON.parse(contents);
+        } catch (parseError) {
+          return callback(parseError);
+        }
+        callback(null, parsed);
+      });
+    }
+  };
 
   _ref = require('event-kit'), Emitter = _ref.Emitter, Disposable = _ref.Disposable;
 
