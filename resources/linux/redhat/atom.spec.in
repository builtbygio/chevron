Name:           <%= appFileName %>
Version:        <%= version %>
Release:        0.1%{?dist}
Summary:        <%= description %>
License:        MIT
URL:            https://github.com/builtbygio/chevron
AutoReqProv:    no # Avoid libchromiumcontent.so missing dependency
Prefix:         <%= installDir %>

%ifarch i386 i486 i586 i686
Requires: alsa-lib, git-core, (glib2 or kde-cli-tools or xdg-utils), (libcurl.so.3 or libcurl.so.4), libgbm.so.1, libgcrypt.so.20, libnotify, libnss3.so, libX11-xcb.so.1, libxcb-dri3.so.0, libxkbfile.so.1, libXss.so.1, libsecret-1.so.0, gtk3, polkit
%else
Requires: alsa-lib, git-core, (glib2 or kde-cli-tools or xdg-utils), (libcurl.so.3()(64bit) or libcurl.so.4()(64bit)), libgbm.so.1()(64bit), libgcrypt.so.20()(64bit), libnotify, libnss3.so()(64bit), libX11-xcb.so.1()(64bit), libxcb-dri3.so.0()(64bit), libxkbfile.so.1()(64bit), libXss.so.1()(64bit), libsecret-1.so.0()(64bit), gtk3, polkit
%endif

Recommends: /usr/bin/lsb_release

# Disable Fedora's shebang mangling script,
# which errors out on any file with versionless `python` in its shebang
# See: https://github.com/atom/atom/issues/21937
%undefine __brp_mangle_shebangs

# Official tree-sitter prebuilds are multi-arch; host strip cannot process
# foreign ELF, and some .node files are not valid strip input. Packaging
# already drops other-arch prebuilds; do not fail the RPM on leftover natives.
%undefine __brp_strip

%description
<%= description %>

# Paths under %{_topdir}/BUILD are absolute so %install works when rpmbuild
# cds into BUILD/%{name}-%{version}-build (rpm 4.20+ / Ubuntu 26 images).
# create-rpm-package.js still stages the app, icons, desktop entry, and
# wrappers directly under BUILD/.

%install
mkdir -p "%{buildroot}/<%= installDir %>/share/<%= appFileName %>/"
cp -r "%{_topdir}/BUILD/<%= appName %>"/* "%{buildroot}/<%= installDir %>/share/<%= appFileName %>/"
mkdir -p "%{buildroot}/<%= installDir %>/bin/"
ln -sf "../share/<%= appFileName %>/resources/app/cpm/bin/cpm" "%{buildroot}/<%= installDir %>/bin/<%= cpmFileName %>"
cp "%{_topdir}/BUILD/atom.sh" "%{buildroot}/<%= installDir %>/bin/<%= appFileName %>"
chmod 755 "%{buildroot}/<%= installDir %>/bin/<%= appFileName %>"
mkdir -p "%{buildroot}/<%= installDir %>/share/applications/"
cp "%{_topdir}/BUILD/<%= appFileName %>.desktop" "%{buildroot}/<%= installDir %>/share/applications/"
mkdir -p "%{buildroot}/<%= installDir %>/share/polkit-1/actions/"
cp "%{_topdir}/BUILD/<%= policyFileName %>" "%{buildroot}/<%= installDir %>/share/polkit-1/actions/<%= policyFileName %>"

mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/1024x1024/apps"
cp "%{_topdir}/BUILD/icons/1024.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/1024x1024/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/512x512/apps"
cp "%{_topdir}/BUILD/icons/512.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/512x512/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/256x256/apps"
cp "%{_topdir}/BUILD/icons/256.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/256x256/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/128x128/apps"
cp "%{_topdir}/BUILD/icons/128.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/128x128/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/64x64/apps"
cp "%{_topdir}/BUILD/icons/64.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/64x64/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/48x48/apps"
cp "%{_topdir}/BUILD/icons/48.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/48x48/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/32x32/apps"
cp "%{_topdir}/BUILD/icons/32.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/32x32/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/24x24/apps"
cp "%{_topdir}/BUILD/icons/24.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/24x24/apps/<%= appFileName %>.png"
mkdir -p "%{buildroot}/<%= installDir %>/share/icons/hicolor/16x16/apps"
cp "%{_topdir}/BUILD/icons/16.png" "%{buildroot}/<%= installDir %>/share/icons/hicolor/16x16/apps/<%= appFileName %>.png"

%files
<%= installDir %>/bin/<%= appFileName %>
<%= installDir %>/bin/<%= cpmFileName %>
<%= installDir %>/share/<%= appFileName %>/
<%= installDir %>/share/applications/<%= appFileName %>.desktop
<%= installDir %>/share/polkit-1/actions/<%= policyFileName %>
<%= installDir %>/share/icons/hicolor/
%attr(4755, root, root) <%= installDir %>/share/<%= appFileName %>/chrome-sandbox
