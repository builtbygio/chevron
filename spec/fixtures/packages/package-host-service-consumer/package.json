{
  "name": "package-host-service-consumer",
  "version": "1.0.0",
  "main": "./lib/main",
  "description": "Consumes an editor-side service from inside the package host (Epic 21.3).",
  "engines": {
    "chevron": ">=1.0.0"
  },
  "consumedServices": {
    "editor-clock": {
      "versions": {
        "^2.0.0": "consumeClock"
      }
    },
    "never-offered": {
      "versions": {
        "^9.0.0": "consumeMissing"
      }
    }
  },
  "providedServices": {
    "consumer-probe": {
      "versions": {
        "1.0.0": "provideProbe"
      }
    }
  }
}
