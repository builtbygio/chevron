#!/usr/bin/env node

'use strict';

require('colors');
const argv = require('yargs')
  .option('core-main', {
    describe: 'Run core main process tests',
    boolean: true,
    default: false
  })
  .option('skip-main', {
    describe:
      'Skip main process tests if they would otherwise run on your platform',
    boolean: true,
    default: false,
    conflicts: 'core-main'
  })
  .option('core-renderer', {
    describe: 'Run core renderer process tests',
    boolean: true,
    default: false
  })
  .option('core-benchmark', {
    describe: 'Run core benchmarks',
    boolean: true,
    default: false
  })
  .option('dry-run', {
    describe:
      'Print the suites this invocation would run, then exit. Needs no build.',
    boolean: true,
    default: false
  })
  .option('platform', {
    describe:
      'Select suites as if on this platform. Only affects which suites are ' +
      'chosen; intended for --dry-run ("what would Linux CI run?").',
    type: 'string',
    default: process.platform
  })
  .option('package', {
    describe: 'Run bundled package specs',
    boolean: true,
    default: false
  })
  .help().argv;

const asyncSeries = require('async/series');
const childProcess = require('child_process');
const fs = require('fs-extra');
const glob = require('glob');
const path = require('path');
const temp = require('temp').track();

const CONFIG = require('./config');
const backupNodeModules = require('./lib/backup-node-modules');
const installPackageDepsHostNpm = require('./lib/install-package-deps-host-npm');
const { findPackagedApp } = require('./lib/find-packaged-app');
const { selectTestSuites } = require('./lib/select-test-suites');

const resourcePath = CONFIG.repositoryRootPath;
const executablePath = findPackagedApp({
  outDir: CONFIG.buildOutputPath,
  platform: process.platform,
  arch: process.arch,
  executableName: CONFIG.executableName,
  appName: CONFIG.appName
});
if (!executablePath && !argv.dryRun) {
  throw new Error(
    '##[error] No Chevron build found. Run "script/build" and try again.'
  );
}

function linuxCiTestArgs(testArguments) {
  if (process.env.CI && process.platform === 'linux') {
    if (!testArguments.includes('--no-sandbox')) {
      testArguments.push('--no-sandbox');
    }
  }
  return testArguments;
}

function prepareEnv(suiteName) {
  const atomHomeDirPath = temp.mkdirSync(suiteName);
  const env = Object.assign({}, process.env, { ATOM_HOME: atomHomeDirPath });

  if (process.env.TEST_JUNIT_XML_ROOT) {
    // Tell Jasmine to output this suite's results as a JUnit XML file to a subdirectory of the root, so that a
    // CI system can interpret it.
    const fileName = suiteName + '.xml';
    const outputPath = path.join(process.env.TEST_JUNIT_XML_ROOT, fileName);
    env.TEST_JUNIT_XML_PATH = outputPath;
  }

  return env;
}

function spawnTest(
  executablePath,
  testArguments,
  options,
  callback,
  testName,
  finalize = null
) {
  const cp = childProcess.spawn(executablePath, testArguments, options);

  // Watchdog: a suite that hangs would otherwise hold the job open forever.
  let killedByWatchdog = false;
  const watchdog =
    SUITE_TIMEOUT_MS > 0
      ? setTimeout(() => {
          killedByWatchdog = true;
          console.error(
            `##[error] ${testName} exceeded ${Math.round(
              SUITE_TIMEOUT_MS / 1000
            )}s and was killed.`
          );
          try {
            cp.kill('SIGKILL');
          } catch (_) {
            /* already gone */
          }
        }, SUITE_TIMEOUT_MS)
      : null;
  const clearWatchdog = () => {
    if (watchdog) clearTimeout(watchdog);
  };

  // collect outputs and errors
  let stderrOutput = '';
  if (cp.stdout) {
    cp.stderr.on('data', data => {
      stderrOutput += data;
    });
    cp.stdout.on('data', data => {
      stderrOutput += data;
    });
  }

  // on error
  cp.on('error', error => {
    clearWatchdog();
    console.log(error, 'error');
    if (finalize) {
      finalize();
    } // if finalizer provided
    callback(error);
  });

  // on close
  cp.on('close', exitCode => {
    clearWatchdog();
    if (exitCode !== 0) {
      retryOrFailTest(
        stderrOutput,
        exitCode,
        executablePath,
        testArguments,
        options,
        callback,
        testName,
        finalize,
        killedByWatchdog
      );
    } else {
      // successful test
      if (finalize) {
        finalize();
      } // if finalizer provided
      callback(null, {
        exitCode,
        step: testName,
        testCommand: `You can run the test again using: \n\t ${executablePath} ${testArguments.join(
          ' '
        )}`
      });
    }
  });
}

const retryNumber = 6; // the number of times a tests repeats
const retriedTests = new Map(); // a cache of retried tests

// A suite that never exits used to run until the CI job cap, so the whole
// nightly was cancelled and reported nothing. Kill an overrunning suite and
// record it as a failure instead: an attributable failure beats no result.
// 0 disables the watchdog (useful when debugging a suite by hand).
const SUITE_TIMEOUT_MS = Number(
  process.env.SPEC_SUITE_TIMEOUT_MS != null
    ? process.env.SPEC_SUITE_TIMEOUT_MS
    : 15 * 60 * 1000
);

// Stop *starting* new suites once the run is near the job cap, so the summary
// and JUnit still get written. 0 disables the budget.
const TOTAL_BUDGET_MS = Number(process.env.SPEC_TOTAL_BUDGET_MS || 0);
const runStartedAt = Date.now();

function budgetExhausted() {
  return TOTAL_BUDGET_MS > 0 && Date.now() - runStartedAt >= TOTAL_BUDGET_MS;
}

// Retries the tests if it is timed out for a number of times. Fails the rest of the tests or those that are tried enough times.
function retryOrFailTest(
  stderrOutput,
  exitCode,
  executablePath,
  testArguments,
  options,
  callback,
  testName,
  finalize,
  killedByWatchdog = false
) {
  const testKey = createTestKey(executablePath, testArguments, testName);
  // A watchdog kill is a hang, not a flake: retrying it just burns the budget
  // again. Only the in-suite timeouts that isTimedOut() recognises are retried.
  if (!killedByWatchdog && isTimedOut(stderrOutput) && shouldTryAgain(testKey)) {
    // retry the timed out test
    let triedNumber = retriedTests.get(testKey) || 0;
    retriedTests.set(testKey, triedNumber + 1);
    console.warn(`\n##[warning] Retrying the timed out step: ${testName} \n`);
    spawnTest(
      executablePath,
      testArguments,
      options,
      callback,
      testName,
      finalize
    );
  } else {
    // fail the test
    if (finalize) {
      finalize();
    } // if finalizer provided
    console.log(
      killedByWatchdog
        ? `##[error] Tests for ${testName} timed out and were killed.`.red
        : `##[error] Tests for ${testName} failed.`.red
    );
    console.log(stderrOutput);
    callback(null, {
      exitCode,
      step: testName,
      testCommand: `You can run the test again using: \n\t ${executablePath} ${testArguments.join(
        ' '
      )}`
    });
  }
}

// creates a key that is specific to a certain test
function createTestKey(executablePath, testArguments, testName) {
  return `${executablePath} ${testArguments.join(' ')} ${testName}`;
}

// check if a test is timed out
function isTimedOut(stderrOutput) {
  if (stderrOutput) {
    return (
      stderrOutput.includes('timeout: timed out after') || // happens in core renderer tests
      stderrOutput.includes('Error: Timed out waiting on') || // happens in core renderer tests
      stderrOutput.includes('Error: timeout of') || // happens in core main tests
      stderrOutput.includes(
        'Error Downloading Update: Could not get code signature for running application'
      ) // happens in github tests
    );
  } else {
    return false;
  }
}

// check if a tests should be tried again
function shouldTryAgain(testKey) {
  if (retriedTests.has(testKey)) {
    return retriedTests.get(testKey) < retryNumber;
  } else {
    return true;
  }
}

function runCoreMainProcessTests(callback) {
  const testPath = path.join(CONFIG.repositoryRootPath, 'spec', 'main-process');
  const testArguments = linuxCiTestArgs([
    '--resource-path',
    resourcePath,
    '--test',
    '--main-process',
    testPath
  ]);

  const testEnv = Object.assign({}, prepareEnv('core-main-process'), {
    ATOM_GITHUB_INLINE_GIT_EXEC: 'true'
  });

  console.log('##[command] Executing core main process tests'.bold.green);
  spawnTest(
    executablePath,
    testArguments,
    { stdio: 'inherit', env: testEnv },
    callback,
    'core-main-process'
  );
}

runCoreMainProcessTests.suiteName = 'core-main-process';

function getCoreRenderProcessTestSuites() {
  // Build an array of functions, each running tests for a different rendering test
  const coreRenderProcessTestSuites = [];
  const testPath = path.join(CONFIG.repositoryRootPath, 'spec');
  let testFiles = glob.sync(
    path.join(testPath, '*-spec.+(js|coffee|ts|jsx|tsx|mjs)')
  );
  for (let testFile of testFiles) {
    const testArguments = linuxCiTestArgs([
      '--resource-path',
      resourcePath,
      '--test',
      testFile
    ]);
    // the function which runs by async:
    const renderSuite = function(callback) {
      const testEnv = prepareEnv('core-render-process');
      console.log(
        `##[command] Executing core render process tests for ${testFile}`.bold
          .green
      );
      spawnTest(
        executablePath,
        testArguments,
        { env: testEnv },
        callback,
        `core-render-process in ${testFile}.`
      );
    };
    renderSuite.suiteName = `core-render ${path.basename(testFile)}`;
    coreRenderProcessTestSuites.push(renderSuite);
  }

  return coreRenderProcessTestSuites;
}

function getPackageTestSuites() {
  // Build an array of functions, each running tests for a different bundled package
  const packageTestSuites = [];
  for (let packageName in CONFIG.appMetadata.packageDependencies) {
    if (process.env.ATOM_PACKAGES_TO_TEST) {
      const packagesToTest = process.env.ATOM_PACKAGES_TO_TEST.split(',').map(
        pkg => pkg.trim()
      );
      if (!packagesToTest.includes(packageName)) continue;
    }

    const repositoryPackagePath = path.join(
      CONFIG.repositoryRootPath,
      'node_modules',
      packageName
    );
    const testSubdir = ['spec', 'test'].find(subdir =>
      fs.existsSync(path.join(repositoryPackagePath, subdir))
    );

    if (!testSubdir) {
      console.log(`No test folder found for package: ${packageName}`.yellow);
      continue;
    }

    const testFolder = path.join(repositoryPackagePath, testSubdir);

    const testArguments = linuxCiTestArgs([
      '--resource-path',
      resourcePath,
      '--test',
      testFolder
    ]);

    const pkgJsonPath = path.join(repositoryPackagePath, 'package.json');
    const nodeModulesPath = path.join(repositoryPackagePath, 'node_modules');

    // the function which runs by async:
    const packageSuite = function(callback) {
      const testEnv = prepareEnv(`bundled-package-${packageName}`);
      let finalize = () => null;
      if (require(pkgJsonPath).atomTestRunner) {
        console.log(
          `##[command] Installing test runner dependencies for ${packageName}`
            .bold.green
        );
        if (fs.existsSync(nodeModulesPath)) {
          const backup = backupNodeModules(repositoryPackagePath);
          finalize = backup.restore;
        } else {
          finalize = () => fs.removeSync(nodeModulesPath);
        }
        installPackageDepsHostNpm(repositoryPackagePath, {
          ignoreScripts: true
        });
        console.log(`##[command] Executing ${packageName} tests`.green);
      } else {
        console.log(`##[command] Executing ${packageName} tests`.bold.green);
      }
      spawnTest(
        executablePath,
        testArguments,
        { env: testEnv },
        callback,
        `${packageName} package`,
        finalize
      );
    };
    packageSuite.suiteName = `package ${packageName}`;
    packageTestSuites.push(packageSuite);
  }

  return packageTestSuites;
}

function runBenchmarkTests(callback) {
  const benchmarksPath = path.join(CONFIG.repositoryRootPath, 'benchmarks');
  const testArguments = ['--benchmark-test', benchmarksPath];
  const testEnv = prepareEnv('benchmark');

  console.log('##[command] Executing benchmark tests'.bold.green);
  spawnTest(
    executablePath,
    testArguments,
    { stdio: 'inherit', env: testEnv },
    callback,
    `core-benchmarks`
  );
}

let testSuitesToRun = requestedTestSuites(argv.platform || process.platform);

runBenchmarkTests.suiteName = 'benchmark';

function requestedTestSuites(platform) {
  // Pure selection lives in lib/select-test-suites.js so the CI unit job can
  // test it without script/node_modules. This wrapper only wires the inputs.
  return selectTestSuites({
    env: process.env,
    platform,
    arch: process.arch,
    flags: {
      coreMain: argv.coreMain,
      coreRenderer: argv.coreRenderer,
      package: argv.package,
      coreBenchmark: argv.coreBenchmark,
      skipMainProcessTests: argv.skipMainProcessTests
    },
    suites: {
      coreMain: runCoreMainProcessTests,
      coreRender: getCoreRenderProcessTestSuites,
      packages: getPackageTestSuites,
      benchmark: runBenchmarkTests
    }
  });
}

// Guard each suite with the total budget: once it is gone, stop starting new
// ones so the summary and JUnit below are still written. Being cancelled by
// the CI job cap produced no output at all, which is what made the nightly
// useless rather than merely red.
const guardedSuites = testSuitesToRun.map((suite, index) =>
  function guardedSuite(callback) {
    if (budgetExhausted()) {
      const step = `suite ${index + 1} of ${testSuitesToRun.length}`;
      console.warn(`##[warning] Skipping ${step}: total time budget exhausted.`);
      return callback(null, { exitCode: 0, skipped: true, step, testCommand: '' });
    }
    return suite(callback);
  }
);

if (argv.dryRun) {
  console.log(
    `Would run ${testSuitesToRun.length} suite(s) on ${argv.platform ||
      process.platform}:`
  );
  for (const suite of testSuitesToRun) {
    console.log('  ' + (suite.suiteName || suite.name || 'anonymous suite'));
  }
  process.exit(0);
}

asyncSeries(guardedSuites, function(err, results) {
  if (err) {
    console.error(err);
    process.exit(1);
  } else {
    const skippedSteps = results.filter(({ skipped }) => skipped);
    if (skippedSteps.length > 0) {
      console.warn(
        `\n##[error] ${skippedSteps.length} of ${results.length} suites did not run: ` +
          `the ${
            TOTAL_BUDGET_MS >= 60000
              ? Math.round(TOTAL_BUDGET_MS / 60000) + '-minute'
              : Math.round(TOTAL_BUDGET_MS / 1000) + '-second'
          } budget ran out. ` +
          'Shrink the shard or raise SPEC_TOTAL_BUDGET_MS.'
      );
    }
    const failedSteps = results.filter(
      ({ exitCode, skipped }) => !skipped && exitCode !== 0
    );

    if (failedSteps.length > 0) {
      console.warn(
        '\n \n ##[error] *** Reporting the errors that happened in all of the tests: *** \n \n'
      );
      for (const { step, testCommand } of failedSteps) {
        console.error(
          `##[error] The '${step}' test step finished with a non-zero exit code \n ${testCommand}`
        );
      }
      process.exit(1);
    }

    // An incomplete run is not a passing run.
    if (skippedSteps.length > 0) process.exit(1);

    process.exit(0);
  }
});
