#!/usr/bin/env node

'use strict'

// Merge the Intel and Apple Silicon builds of Chevron.app into one universal
// bundle. See script/lib/make-mac-universal.js for what the merge has to
// work around; CI runs this after the two macOS build jobs.
//
//   ./script/mac-universal --x64 path/to/x64/Chevron.app \
//                          --arm64 path/to/arm64/Chevron.app \
//                          [--out out/Chevron.app] [--code-sign] [--compress-artifacts] [--update-metadata]

require('colors')

const path = require('path')
const yargs = require('yargs')
const argv = yargs
  .usage('Usage: $0 --x64 <Chevron.app> --arm64 <Chevron.app> [options]')
  .help('help')
  .describe('x64', 'The Intel build of the app bundle')
  .describe('arm64', 'The Apple Silicon build of the app bundle')
  .describe('out', 'Where to write the universal bundle (default: out/<AppName>.app)')
  .describe('code-sign', 'Sign with the Developer ID in CSC_LINK / CSC_KEY_PASSWORD and notarize with APPLE_*; ad-hoc when those are unset')
  .describe('compress-artifacts', 'Also write out/chevron-mac-universal.zip')
  .describe('update-metadata', 'Also write out/latest-mac.yml for electron-updater (needs --compress-artifacts)')
  .string('x64')
  .string('arm64')
  .string('out')
  .boolean('code-sign')
  .boolean('compress-artifacts')
  .boolean('update-metadata')
  .demand(['x64', 'arm64'])
  .wrap(yargs.terminalWidth())
  .argv

const CONFIG = require('./config')
const compressArtifacts = require('./lib/compress-artifacts')
const { makeMacUniversal, adHocSign } = require('./lib/make-mac-universal')
const { markUpdateConfigSigned } = require('./lib/update-config-file')
const { writeUpdateMetadata } = require('./lib/generate-update-metadata')

const UNIVERSAL_ARCHIVE = 'chevron-mac-universal.zip'

process.on('unhandledRejection', function (e) {
  console.error(e.stack || e)
  process.exit(1)
})

const outAppPath = argv.out || path.join(CONFIG.buildOutputPath, `${CONFIG.appName}.app`)

makeMacUniversal({ x64AppPath: argv.x64, arm64AppPath: argv.arm64, outAppPath })
  .then(async () => {
    let signed = false
    if (argv.codeSign) {
      // Loaded here, not above: the CI merge job installs the script tree
      // without lifecycle scripts, and these pull in more than the merge needs.
      const codeSignOnMac = require('./lib/code-sign-on-mac')
      if (codeSignOnMac.signingCertificateFromEnv()) {
        // Before codesign: the file sits in Resources, which the signature seals.
        markUpdateConfigSigned(path.join(outAppPath, 'Contents', 'Resources'))
        signed = await codeSignOnMac(outAppPath)
        await require('./lib/notarize-on-mac')(outAppPath)
      }
    }
    if (!signed) {
      console.log('Ad-hoc signing the universal bundle: no Developer ID certificate in CSC_LINK.'.gray)
      adHocSign(outAppPath)
    }
    if (argv.compressArtifacts) {
      compressArtifacts(outAppPath, { archiveName: UNIVERSAL_ARCHIVE })
    }
    if (argv.updateMetadata) {
      const file = writeUpdateMetadata({
        outDir: CONFIG.buildOutputPath,
        platform: 'darwin',
        version: CONFIG.computedAppVersion,
        artifactPaths: [path.join(CONFIG.buildOutputPath, UNIVERSAL_ARCHIVE)]
      })
      console.log(`Update metadata at ${file}`)
    }
    console.log(`Universal bundle at ${outAppPath}`.green)
  })
  .catch(error => {
    console.error(error.stack || error)
    process.exit(1)
  })
