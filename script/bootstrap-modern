#!/usr/bin/env bash
# Chevron bootstrap for modern host toolchains (macOS 13+ / Linux / Windows via Git Bash).
#
# Phase 0: root app dependencies use **host npm** (not apm/Node 12).
# Phase 4: product ships cpm only; --with-apm is deprecated (debug only).
# Electron natives are still patched and rebuilt with modern node-gyp.
#
# Usage:
#   ./script/bootstrap-modern
#   ./script/bootstrap-modern --ci
#
# Then build with:
#   ./script/with-modern-env ./script/build --no-bootstrap

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/modern-env.sh"

WITH_APM=false
for arg in "$@"; do
  case "$arg" in
    --ci) export CI=true ;;
    --with-apm) WITH_APM=true ;;
  esac
done
if [ "${CI:-}" = "true" ]; then
  echo "CI mode enabled"
fi
if [ "$WITH_APM" = true ]; then
  echo "NOTE: --with-apm is deprecated (Phase 4 debug only)"
fi

echo ""
echo "==> Chevron modern bootstrap (host npm for app deps)"
echo "    repo: $REPO_ROOT"
echo ""

# --- Step 1: stock verify + script dependencies (host Node) ------------------
node <<'NODE'
'use strict';
const path = require('path');
process.chdir(path.join(__dirname));

const CONFIG = require('./script/config');
const cleanDependencies = require('./script/lib/clean-dependencies');
const deleteMsbuildFromPath = require('./script/lib/delete-msbuild-from-path');
const dependenciesFingerprint = require('./script/lib/dependencies-fingerprint');
const installScriptDependencies = require('./script/lib/install-script-dependencies');
const verifyMachineRequirements = require('./script/lib/verify-machine-requirements');

const ci = process.argv.includes('--ci') || process.env.CI === 'true';

process.on('unhandledRejection', e => {
  console.error(e.stack || e);
  process.exit(1);
});

verifyMachineRequirements(ci);
if (dependenciesFingerprint.isOutdated()) {
  console.log('Dependencies fingerprint outdated; cleaning…');
  cleanDependencies();
}
if (process.platform === 'win32') deleteMsbuildFromPath();

console.log('Installing script dependencies…');
installScriptDependencies(ci);
console.log('Script dependencies installed.');
NODE

echo "Patching node-gyp (script) for Python 3.11+ (rU->r)..."
chevron_patch_node_gyp "$REPO_ROOT/script"

# --- Step 2: root app dependencies via host npm (Phase 0) --------------------
unset npm_config_target npm_config_runtime npm_config_disturl npm_config_build_from_source || true
export ATOM_ELECTRON_URL="${ATOM_ELECTRON_URL:-https://www.electronjs.org/headers}"
export ATOM_RESOURCE_PATH="$REPO_ROOT"

# Warm-cache path: if CI restored node_modules and the deps fingerprint still
# matches, skip `npm ci` (which would delete node_modules and wipe .node builds).
SKIP_APP_NPM=false
if [ -d "$REPO_ROOT/node_modules" ] \
  && [ -f "$REPO_ROOT/node_modules/.dependencies-fingerprint" ] \
  && [ -f "$REPO_ROOT/node_modules/superstring/package.json" ]; then
  if node -e 'const d=require("./script/lib/dependencies-fingerprint"); process.exit(d.isOutdated()?1:0)'; then
    SKIP_APP_NPM=true
    echo "Skipping app npm ci (node_modules present, dependencies fingerprint current)."
  fi
fi

if [ "$SKIP_APP_NPM" = false ]; then
  node <<'NODE'
'use strict';
const installAppDependencies = require('./script/lib/install-app-dependencies');
const ci = process.argv.includes('--ci') || process.env.CI === 'true';
process.on('unhandledRejection', e => {
  console.error(e.stack || e);
  process.exit(1);
});
installAppDependencies(ci, { ignoreScripts: true, legacyPeerDeps: true });
NODE
fi

# Phase 1: cpm CLI dependencies (pacote, arborist, @electron/rebuild)
if [ -d "$REPO_ROOT/cpm" ] && [ -f "$REPO_ROOT/cpm/package.json" ]; then
  echo "Installing cpm dependencies (host npm)…"
  if [ -f "$REPO_ROOT/cpm/package-lock.json" ]; then
    (cd "$REPO_ROOT/cpm" && npm ci --ignore-scripts) || \
      (cd "$REPO_ROOT/cpm" && npm install --ignore-scripts)
  else
    (cd "$REPO_ROOT/cpm" && npm install --ignore-scripts)
  fi
fi

# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/force-patched-superstring.sh"
chevron_force_patched_superstring "$REPO_ROOT"

echo "Patching natives for NODE_MODULE_CONTEXT_AWARE…"
node "$SCRIPT_DIR/lib/patch-natives-context-aware.js" "$REPO_ROOT"

echo "Patching keytar nested nan for Electron 14+…"
node "$SCRIPT_DIR/lib/patch-keytar-nan.js" "$REPO_ROOT"

echo "Patching spellchecker for modern MSVC…"
node "$SCRIPT_DIR/lib/patch-spellchecker-win.js" "$REPO_ROOT"

echo "Replacing outdated nested nan copies with root nan…"
node "$SCRIPT_DIR/lib/patch-nested-nan.js" "$REPO_ROOT"

echo "Patching bundled packages for remote->IPC..."
node "$SCRIPT_DIR/lib/patch-packages-remote-ipc.js" "$REPO_ROOT"

echo "Patching tree-view Stats flattening for modern Node…"
node "$SCRIPT_DIR/lib/patch-tree-view-stats.js" "$REPO_ROOT"

echo "Patching natives for removed V8 APIs…"
node "$SCRIPT_DIR/lib/patch-v8-api.js" "$REPO_ROOT"

echo "Patching oniguruma gyp for GCC 14+…"
node "$SCRIPT_DIR/lib/patch-oniguruma-gyp.js" "$REPO_ROOT"

echo "Patching nested package.json metadata (isbinaryfile, etc.)…"
node "$SCRIPT_DIR/lib/patch-dep-package-json.js" "$REPO_ROOT"

# Class C decaff/debabel patches retired: owned pins ship plain JS.

# --- Step 3: rebuild natives for Electron ------------------------------------
echo "Rebuilding native modules for Electron…"
export ATOM_RESOURCE_PATH="$REPO_ROOT"
export ATOM_ELECTRON_URL="${ATOM_ELECTRON_URL:-https://www.electronjs.org/headers}"
ELECTRON_VERSION="$(node -p "require('./package.json').electronVersion")"
ELECTRON_MAJOR="${ELECTRON_VERSION%%.*}"
export npm_config_target="$ELECTRON_VERSION"
export npm_config_disturl="${ATOM_ELECTRON_URL}"
export npm_config_runtime=electron
export npm_config_build_from_source=true
export npm_config_arch="${npm_config_arch:-$(node -p "process.arch")}"

MODERN_GYP="$REPO_ROOT/script/node_modules/.bin/node-gyp"
rebuild_package_modern() {
  local pkg="$1"
  local arch
  local attempt
  arch="$(node -p "process.arch")"
  if [ "${OS:-}" = "Windows_NT" ] || [[ "$(uname -s 2>/dev/null)" == MINGW* ]] || [[ "$(uname -s 2>/dev/null)" == MSYS* ]]; then
    for attempt in 1 2 3; do
      if (cd "$pkg" && npx --yes node-gyp@11 rebuild \
        --target="$ELECTRON_VERSION" \
        --dist-url="$ATOM_ELECTRON_URL" \
        --runtime=electron \
        --arch="$arch"); then
        return 0
      fi
      echo "WARNING: rebuild attempt $attempt failed for $pkg; clearing build/ and retrying..."
      rm -rf "$pkg/build" 2>/dev/null || true
      sleep 2
    done
    return 1
  else
    (cd "$pkg" && "$MODERN_GYP" rebuild \
      --target="$ELECTRON_VERSION" \
      --dist-url="$ATOM_ELECTRON_URL" \
      --runtime=electron \
      --arch="$arch")
  fi
}

# Decide whether to force-rebuild natives. With --ignore-scripts installs, a
# cold node_modules has no .node files. When CI restores a cached node_modules
# whose natives fingerprint still matches, skip the expensive gyp rebuilds.
# Force with CHEVRON_FORCE_NATIVE_REBUILD=1.
SKIP_NATIVE_REBUILD=false
NATIVE_FP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/chevron-nfp.XXXXXX")"
export NATIVE_FP_DIR
node <<'NODE'
'use strict';
const fs = require('fs');
const path = require('path');
const n = require('./script/lib/natives-fingerprint');
const d = n.shouldSkipRebuild();
const dir = process.env.NATIVE_FP_DIR;
if (!dir) {
  console.error('NATIVE_FP_DIR not set');
  process.exit(1);
}
fs.writeFileSync(path.join(dir, 'fingerprint'), d.fingerprint);
fs.writeFileSync(path.join(dir, 'reason'), d.reason);
fs.writeFileSync(path.join(dir, 'skip'), d.skip ? 'true' : 'false');
NODE
NATIVE_FP="$(cat "$NATIVE_FP_DIR/fingerprint")"
NATIVE_SKIP_REASON="$(cat "$NATIVE_FP_DIR/reason")"
NATIVE_SKIP="$(cat "$NATIVE_FP_DIR/skip")"
rm -rf "$NATIVE_FP_DIR"
if [ "${NATIVE_SKIP:-false}" = true ]; then
  SKIP_NATIVE_REBUILD=true
  echo "Skipping native rebuild ($NATIVE_SKIP_REASON)."
  echo "  fingerprint: $NATIVE_FP"
else
  echo "Native rebuild required ($NATIVE_SKIP_REASON)."
  echo "  fingerprint: $NATIVE_FP"
fi

if [ "$SKIP_NATIVE_REBUILD" = false ]; then
  echo "Electron $ELECTRON_VERSION: modern node-gyp force rebuild of critical natives"
  # Skip blanket `npm rebuild`: host/app nested node-gyp is too old for Node 24
  # (read-only cflags crash) and prints hard errors even when the modern force
  # list below succeeds. Install used --ignore-scripts, so nothing has .node yet
  # on a cold tree.

  echo "Force-rebuilding critical natives for Electron $ELECTRON_VERSION..."
  # keyboard-layout is required at runtime (smoke fails without keyboard-layout-manager.node).
  # ctags / fs-admin / oniguruma are also app natives not covered by a partial list.
  CRITICAL_REBUILD_FAILED=0
  for _pkg in \
    superstring tree-sitter \
    '@atom/watcher' '@atom/nsfw' '@atom/fuzzy-native' \
    keytar spellchecker pathwatcher git-utils scrollbar-style nslog \
    keyboard-layout ctags fs-admin oniguruma
  do
    _dir="$REPO_ROOT/node_modules/$_pkg"
    if [ -d "$_dir" ]; then
      echo "  rebuild $_pkg..."
      if ! rebuild_package_modern "$_dir"; then
        echo "ERROR: rebuild failed for $_pkg" >&2
        CRITICAL_REBUILD_FAILED=1
      fi
    else
      echo "ERROR: critical package missing from node_modules: $_pkg" >&2
      CRITICAL_REBUILD_FAILED=1
    fi
  done

  echo "Force-rebuilding tree-sitter language bindings..."
  # tree-sitter-typescript ships comment-only placeholder binding.gyp files under
  # tsx/ and typescript/; only rebuild dirs whose binding.gyp is real JSON (starts
  # with '{'). The package root binding builds both language targets.
  while IFS= read -r _gyp; do
    [ -z "$_gyp" ] && continue
    # Skip non-JSON placeholders (gyp would SyntaxError on '# comment' lines).
    if ! head -c 1 "$_gyp" 2>/dev/null | grep -q '{'; then
      echo "  skip placeholder binding.gyp: $_gyp"
      continue
    fi
    _dir="$(cd "$(dirname "$_gyp")" && pwd)"
    echo "  rebuild $_dir..."
    # Language bindings are best-effort: missing optional grammars should not
    # fail bootstrap (critical tree-sitter core is already hard-gated above).
    rebuild_package_modern "$_dir" || \
      echo "WARNING: tree-sitter language rebuild failed for $_dir (non-fatal)"
  done < <(find "$REPO_ROOT/node_modules" -path '*/tree-sitter-*/binding.gyp' 2>/dev/null | sort -u)

  if [ "$CRITICAL_REBUILD_FAILED" -ne 0 ]; then
    if [ "${CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES:-}" = "1" ] || \
       [ "${CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES:-}" = "true" ]; then
      echo "WARNING: critical native rebuild failures ignored (CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES=1)"
    else
      echo "error: one or more critical native rebuilds failed (see ERROR lines above)." >&2
      echo "  Override only for local debugging: CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES=1" >&2
      exit 1
    fi
  fi
fi

# Artifact gate (warm-cache skip path and rebuild path).
node <<'NODE'
'use strict';
const path = require('path');
const {
  checkCriticalNatives,
  allowNativeFailures
} = require('./script/lib/critical-natives');
const repoRoot = process.cwd();
const result = checkCriticalNatives(repoRoot);
if (result.ok) {
  console.log(`Critical natives: ${result.found.length} packages OK.`);
  process.exit(0);
}
console.error('Critical native artifacts missing:');
for (const m of result.missing) {
  console.error(`  - ${m.name}: ${m.reason}`);
}
if (allowNativeFailures()) {
  console.warn(
    'WARNING: continuing with missing natives (CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES=1)'
  );
  process.exit(0);
}
console.error(
  'error: bootstrap cannot continue. Rebuild natives or set CHEVRON_ALLOW_NATIVE_REBUILD_FAILURES=1'
);
process.exit(1);
NODE

DUGITE_GIT="$REPO_ROOT/node_modules/dugite/git/bin/git"
if [ ! -x "$DUGITE_GIT" ]; then
  echo "Downloading dugite embedded git…"
  (cd "$REPO_ROOT/node_modules/dugite" && node ./script/download-git.js) || \
    echo "WARNING: dugite git download failed — will try system git fallback."
fi
if [ ! -x "$DUGITE_GIT" ] && command -v git >/dev/null 2>&1; then
  echo "Stubbing dugite git layout with system git ($(uname -m))…"
  mkdir -p "$REPO_ROOT/node_modules/dugite/git/bin"
  mkdir -p "$REPO_ROOT/node_modules/dugite/git/libexec"
  ln -sfn "$(command -v git)" "$DUGITE_GIT"
  if [ -d /usr/lib/git-core ]; then
    ln -sfn /usr/lib/git-core "$REPO_ROOT/node_modules/dugite/git/libexec/git-core"
  elif [ -d /usr/libexec/git-core ]; then
    ln -sfn /usr/libexec/git-core "$REPO_ROOT/node_modules/dugite/git/libexec/git-core"
  fi
fi
if [ -x "$DUGITE_GIT" ] || [ -L "$DUGITE_GIT" ]; then
  echo "dugite git present: $DUGITE_GIT"
else
  echo "WARNING: dugite git still missing at $DUGITE_GIT"
fi

echo "Re-syncing nested natives from rebuilt root packages…"
chevron_resync_nested_built_natives "$REPO_ROOT"

if [ ! -f "$REPO_ROOT/node_modules/superstring/build/Release/superstring.node" ]; then
  echo "error: superstring.node missing after rebuild" >&2
  exit 1
fi
if [ ! -f "$REPO_ROOT/node_modules/text-buffer/node_modules/superstring/build/Release/superstring.node" ] \
  && [ -d "$REPO_ROOT/node_modules/text-buffer/node_modules/superstring" ]; then
  echo "error: nested text-buffer superstring.node missing after resync" >&2
  exit 1
fi

# Record natives fingerprint only when critical artifacts exist (skip or rebuild).
node -e 'require("./script/lib/natives-fingerprint").write(); console.log("Natives fingerprint written.");'

# --- Step 4: classic apm tree (Phase 4 retired from product) -----------------
# Product packages ship cpm only. --with-apm remains for rare local debugging
# of historical atom-package-manager, not for packaging.
if [ "$WITH_APM" = true ]; then
  echo "WARNING: --with-apm is deprecated (Phase 4). Product no longer bundles classic apm."
  echo "Installing apm for local debugging only…"
  node <<'NODE'
'use strict';
const installApm = require('./script/lib/install-apm');
const ci = process.env.CI === 'true';
process.on('unhandledRejection', e => {
  console.error(e.stack || e);
  process.exit(1);
});
installApm(ci, { ignoreScripts: true });
NODE
else
  echo "Classic apm not installed (Phase 4: product uses cpm; apm name is a cpm shim)."
fi

# --- Step 5: fingerprint -----------------------------------------------------
node <<'NODE'
'use strict';
require('./script/lib/dependencies-fingerprint').write();
console.log('Dependencies fingerprint written.');
NODE

echo ""
echo "==> Modern bootstrap complete (host npm app deps)."
echo "    Build with:  ./script/with-modern-env ./script/build --no-bootstrap"
echo ""
