  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if (!ua.includes('pnpm')) { console.error('Chevron app deps are installed with pnpm. Run: pnpm install'); process.exit(1); }\"",
    "test": "node script/test"
  },
  "standard-engine": "./script/node_modules/standard",
  "standard": {
    "env": {
      "atomtest": true,
      "browser": true,
      "jasmine": true,
      "node": true
    },
    "globals": [
      "atom",
      "snapshotResult"
    ]
  },
  "configSchema": {
    "lsp": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "default": {},
          "description": "User language server map. Keys are scope names (e.g. source.rust) or server ids; values are { command, args?, scopes?, initializationOptions? }. Package-registered servers take precedence. Binaries must be on PATH."
        },
        "formatOnSave": {
          "type": "boolean",
          "default": false,
          "title": "Format on Save",
          "description": "Run language-server document formatting before save when a server is active."
        }
      }
    }
  },
  "packageManager": "pnpm@11.22.0"
}
