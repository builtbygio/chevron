{
  "extends": [
    "./script/node_modules/eslint-config-standard/index.js",
    "./script/node_modules/eslint-config-prettier/index.js"
  ],
  "plugins": [
    "prettier"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "globals": {
    "atom": true,
    "chevron": true,
    "snapshotResult": true
  },
  "rules": {
    "n/no-deprecated-api": ["off"],
    "n/no-callback-literal": ["off"],
    "prefer-const": ["off"],
    "lines-between-class-members": ["off"],
    "object-shorthand": ["off"],
    "prettier/prettier": ["off"]
  },
  "ignorePatterns": [
    "node_modules/**",
    "script/node_modules/**",
    "out/**",
    "**/*.ts"
  ],
  "overrides": [
    {
      "files": ["spec/**", "**-spec.js", "**.test.js"],
      "env": {
        "jasmine": true
      },
      "globals": {
        "advanceClock": true,
        "fakeClearInterval": true,
        "fakeSetInterval": true,
        "waitsForPromise": true
      }
    }
  ]
}
