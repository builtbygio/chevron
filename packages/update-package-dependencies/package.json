{
  "name": "@builtbygio/update-package-dependencies",
  "main": "./lib/update-package-dependencies",
  "version": "0.13.1",
  "description": "Runs package-manager install (cpm / apm shim) for the current project",
  "repository": "https://github.com/builtbygio/chevron",
  "license": "MIT",
  "engines": {
    "chevron": "*",
    "atom": ">0.39.0"
  },
  "activationCommands": {
    "atom-workspace": [
      "update-package-dependencies:update"
    ]
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.1.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {},
  "standard": {
    "env": {
      "atomtest": true,
      "browser": true,
      "jasmine": true,
      "node": true
    },
    "globals": [
      "atom"
    ]
  }
}
