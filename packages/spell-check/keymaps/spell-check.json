{
  ".platform-darwin chevron-text-editor": {
    "cmd-:": "spell-check:correct-misspelling"
  },
  ".platform-darwin .corrections chevron-text-editor": {
    "cmd-:": "core:cancel"
  },
  ".platform-win32 chevron-text-editor": {
    "ctrl-:": "spell-check:correct-misspelling"
  },
  ".platform-win32 .corrections chevron-text-editor": {
    "ctrl-:": "core:cancel"
  },
  ".platform-linux chevron-text-editor": {
    "ctrl-:": "spell-check:correct-misspelling"
  },
  ".platform-linux .corrections chevron-text-editor": {
    "ctrl-:": "core:cancel"
  },
  ".corrections chevron-text-editor[mini]": {
    "enter": "core:confirm",
    "tab": "core:confirm"
  }
}
