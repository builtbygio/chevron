{
  "name": "@builtbygio/settings-view",
  "version": "0.261.15",
  "main": "./lib/main",
  "description": "Edit config settings, install packages, and change themes",
  "license": "MIT",
  "uriHandler": {
    "method": "handleURI",
    "deferActivation": false
  },
  "configSchema": {
    "packageUpdateConcurrency": {
      "title": "Maximum simultaneous package updates",
      "description": "Limit how many processes run simultaneously during package updates. If your machine slows down while updating many packages at once, set this value to a small positive number (e.g., `1` or `2`).",
      "type": "integer",
      "default": -1
    }
  },
  "dependencies": {
    "async": "^3.2.0",
    "dompurify": "3.4.13",
    "etch": "^0.14.1",
    "fs-plus": "^3.0.0",
    "fuzzaldrin": "^2.1",
    "glob": "^7.2.3",
    "hosted-git-info": "^2.1.4",
    "marked": "4.3.0",
    "season": "^6.0.2",
    "semver": "^7.8.5",
    "underscore-plus": "^1.0.6"
  },
  "repository": "https://github.com/builtbygio/settings-view",
  "engines": {
    "atom": "*",
    "chevron": "*"
  },
  "consumedServices": {
    "snippets": {
      "versions": {
        "0.1.0": "consumeSnippets"
      }
    }
  },
  "deserializers": {
    "SettingsView": "createSettingsView"
  },
  "standard": {
    "env": [
      "browser",
      "node",
      "atomtest",
      "jasmine"
    ],
    "globals": [
      "atom"
    ]
  }
}
