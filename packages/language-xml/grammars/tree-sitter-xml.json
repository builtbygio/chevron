{
  "name": "XML",
  "scopeName": "text.xml",
  "type": "tree-sitter",
  "parser": "@tree-sitter-grammars/tree-sitter-xml/xml",
  "injectionRegex": "xml",
  "firstLineRegex": [
    "^<\\?xml",
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=xml"
  ],
  "fileTypes": [
    "aiml",
    "atom",
    "axml",
    "bpmn",
    "config",
    "cpt",
    "csl",
    "csproj",
    "csproj.user",
    "dae",
    "dia",
    "dita",
    "ditamap",
    "dtml",
    "fodg",
    "fodp",
    "fods",
    "fodt",
    "fsproj",
    "fxml",
    "gir",
    "glade",
    "gpx",
    "graphml",
    "icls",
    "iml",
    "isml",
    "jmx",
    "jsp",
    "kml",
    "kst",
    "launch",
    "menu",
    "mxml",
    "nunit",
    "nuspec",
    "opml",
    "owl",
    "pom",
    "ppj",
    "proj",
    "pt",
    "pubxml",
    "pubxml.user",
    "rdf",
    "rng",
    "rss",
    "sdf",
    "shproj",
    "siml",
    "sld",
    "storyboard",
    "StyleCop",
    "svg",
    "targets",
    "tld",
    "vbox",
    "vbox-prev",
    "vbproj",
    "vbproj.user",
    "vcproj",
    "vcproj.filters",
    "vcxproj",
    "vcxproj.filters",
    "wixmsp",
    "wixmst",
    "wixobj",
    "wixout",
    "wsdl",
    "wxs",
    "xaml",
    "xbl",
    "xib",
    "xlf",
    "xliff",
    "xml",
    "xpdl",
    "xsd",
    "xul",
    "ui"
  ],
  "comments": {
    "start": "<!--",
    "end": "-->"
  },
  "folds": [
    {
      "type": "element"
    },
    {
      "type": "CDSect"
    },
    {
      "type": "doctypedecl"
    },
    {
      "type": "Comment"
    }
  ],
  "scopes": {
    "document": "text.xml",
    "Comment": "comment.block.xml",
    "Name": "entity.name.tag.xml",
    "STag > Name": "entity.name.tag.localname.xml",
    "ETag > Name": "entity.name.tag.localname.xml",
    "EmptyElemTag > Name": "entity.name.tag.localname.xml",
    "Attribute > Name": "entity.other.attribute-name.localname.xml",
    "AttValue": "string.quoted.double.xml",
    "CharData": "text.xml",
    "CData": "string.unquoted.cdata.xml",
    "CDStart": "punctuation.definition.string.begin.xml",
    "EntityRef": "constant.character.entity.xml",
    "CharRef": "constant.character.entity.xml",
    "PI": "meta.tag.preprocessor.xml",
    "XMLDecl": "meta.tag.preprocessor.xml",
    "doctypedecl": "meta.tag.sgml.doctype.xml",
    "\"<\"": "punctuation.definition.tag.begin.xml",
    "\"</\"": "punctuation.definition.tag.begin.xml",
    "\">\"": "punctuation.definition.tag.end.xml",
    "\"/>\"": "punctuation.definition.tag.end.xml",
    "\"<?\"": "punctuation.definition.tag.begin.xml",
    "\"?>\"": "punctuation.definition.tag.end.xml",
    "\"=\"": "punctuation.separator.key-value.xml"
  }
}