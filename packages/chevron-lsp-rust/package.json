{
  "name": "chevron-lsp-rust",
  "version": "0.1.0",
  "description": "Optional rust-analyzer language server for Chevron (cpm install; not bundled in the app)",
  "main": "./lib/main",
  "repository": "https://github.com/builtbygio/chevron",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "chevron": ">=0.6.0"
  },
  "chevron": {
    "languageServer": {
      "id": "rust-analyzer",
      "scopes": ["source.rust"],
      "command": "bin/rust-analyzer",
      "args": [],
      "tag": "2025-01-20",
      "prebuilds": {
        "linux-x64": "https://github.com/rust-lang/rust-analyzer/releases/download/{tag}/rust-analyzer-x86_64-unknown-linux-gnu.gz",
        "linux-arm64": "https://github.com/rust-lang/rust-analyzer/releases/download/{tag}/rust-analyzer-aarch64-unknown-linux-gnu.gz",
        "darwin-x64": "https://github.com/rust-lang/rust-analyzer/releases/download/{tag}/rust-analyzer-x86_64-apple-darwin.gz",
        "darwin-arm64": "https://github.com/rust-lang/rust-analyzer/releases/download/{tag}/rust-analyzer-aarch64-apple-darwin.gz",
        "win32-x64": "https://github.com/rust-lang/rust-analyzer/releases/download/{tag}/rust-analyzer-x86_64-pc-windows-msvc.gz"
      }
    }
  },
  "consumedServices": {
    "chevron.lsp": {
      "versions": {
        "1.0.0": "consumeLsp"
      }
    }
  }
}
