{
  "name": "@builtbygio/terminal",
  "version": "0.1.0",
  "main": "./lib/main",
  "description": "A terminal in a pane, backed by the pty host.",
  "license": "MIT",
  "repository": "https://github.com/builtbygio/chevron",
  "engines": {
    "chevron": "*",
    "atom": "*"
  },
  "activationCommands": {
    "atom-workspace": [
      "terminal:open",
      "terminal:toggle",
      "tasks:run"
    ]
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "atom-select-list": "^0.8.2"
  },
  "configSchema": {
    "shell": {
      "type": "string",
      "default": "",
      "title": "Shell",
      "description": "Absolute path to the shell to run. Empty uses $SHELL, or cmd.exe on Windows."
    },
    "fontSize": {
      "type": "integer",
      "default": 13,
      "minimum": 6,
      "maximum": 48,
      "title": "Font size"
    },
    "scrollback": {
      "type": "integer",
      "default": 2000,
      "minimum": 100,
      "maximum": 100000,
      "title": "Scrollback lines"
    }
  }
}
